{
  "name": "contorno-studio",
  "version": "1.1.0",
  "private": true,
  "description": "Converta imagens em SVG e STL diretamente no navegador.",
  "author": "Contorno Studio",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare-wasm.mjs",
    "dev": "next dev --webpack",
    "build": "node scripts/prepare-wasm.mjs && next build --webpack",
    "start": "next start",
