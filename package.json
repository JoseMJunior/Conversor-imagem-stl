    "test": "vitest run",
    "test:e2e": "node scripts/smoke-web.mjs"
  },
  "dependencies": {
    "d3-contour": "^4.0.2",
    "lucide-react": "^1.60.0",
    "manifold-3d": "3.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "next": "16.4.2"
  },
  "devDependencies": {
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": "24.x"
  }
